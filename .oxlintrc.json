{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "import", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "rules": {
    "no-console": "warn",
    "react/react-in-jsx-scope": "off",
    "no-await-in-loop": "off",
    "import/no-unassigned-import": "off",
    "vitest/expect-expect": [
      "error",
      { "assertFunctionNames": ["expect", "expect*", "assert*"] }
    ],
    "no-underscore-dangle": "off"
  },
  "overrides": [
    {
      "files": ["**/*.test.ts", "**/*.test.tsx", "**/*.spec.ts"],
      "rules": {
        "react/no-object-type-as-default-prop": "off",
        "react/globals": "off",
        "react/immutability": "off"
      }
    },
    {
      "files": ["packages/vscode-e2e/tests/**/*.ts"],
      "rules": {
        "jest/expect-expect": [
          "error",
          { "assertFunctionNames": ["assert", "assert.*"] }
        ]
      }
    },
    {
      "files": ["packages/core/src/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/index.js", "**/index"],
                "message": "Do not import a barrel (any index.js or extensionless index, nested ones included) inside packages/core/src: import the module by its own path (e.g. ./parser/parser.js), since a barrel import creates runtime cycles. Test files (*.test.ts, *.spec.ts) may import ../index.js."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/core/src/**/*.test.ts", "packages/core/src/**/*.spec.ts"],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "settings": {
    "react": {
      "version": "19"
    }
  },
  "ignorePatterns": ["dist", "dist-viewer", "dist-serve", "dist-vscode-webview", "viewer-assets", "out", "node_modules", "*.d.ts"]
}
