{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "import", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "rules": {
    "no-console": "warn",
    "react/react-in-jsx-scope": "off",
    "no-await-in-loop": "off",
    "import/no-unassigned-import": "off",
    "vitest/expect-expect": [
      "error",
      { "assertFunctionNames": ["expect", "expect*", "assert*"] }
    ],
    "no-underscore-dangle": "off"
  },
  "overrides": [
    {
      "files": ["**/*.test.ts", "**/*.test.tsx", "**/*.spec.ts"],
      "rules": {
        "react/no-object-type-as-default-prop": "off",
        "react/globals": "off",
        "react/immutability": "off"
      }
    },
    {
      "files": ["packages/vscode-e2e/tests/**/*.ts"],
      "rules": {
        "jest/expect-expect": [
          "error",
          { "assertFunctionNames": ["assert", "assert.*"] }
        ]
      }
    },
    {
      "files": ["packages/core/src/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/index.js", "**/index"],
                "message": "Do not import a barrel (any index.js or extensionless index, nested ones included) inside packages/core/src: import the module by its own path (e.g. ./parser/parser.js), since a barrel import creates runtime cycles. Test files (*.test.ts, *.spec.ts) may import ../index.js."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/core/src/**/*.test.ts", "packages/core/src/**/*.spec.ts"],
      "rules": {
        "no-restricted-imports": "off"
      }
    },
    {
      "files": ["packages/*/src/**/*.{ts,tsx,mts,cts}"],
      "excludeFiles": [
        "**/*.{test,spec}.{ts,tsx,mts,cts}",
        "**/*.generated.ts",
        "packages/core/src/builtins/examples.ts"
      ],
      "rules": {
        "max-lines": ["error", { "max": 600 }]
      }
    },
    { "files": ["packages/app/src/components/PreviewPane.tsx"], "rules": { "max-lines": ["error", { "max": 848 }] } },
    { "files": ["packages/app/src/components/focus-canvas/build.ts"], "rules": { "max-lines": ["error", { "max": 859 }] } },
    { "files": ["packages/app/src/hooks/useChatSession.ts"], "rules": { "max-lines": ["error", { "max": 626 }] } },
    { "files": ["packages/app/src/hooks/useChatSession/prompt.ts"], "rules": { "max-lines": ["error", { "max": 610 }] } },
    { "files": ["packages/cli/src/index.ts"], "rules": { "max-lines": ["error", { "max": 686 }] } },
    { "files": ["packages/core/src/builtins/default-style.ts"], "rules": { "max-lines": ["error", { "max": 711 }] } },
    { "files": ["packages/core/src/builtins/reference-data.ts"], "rules": { "max-lines": ["error", { "max": 1282 }] } },
    { "files": ["packages/core/src/compile/compile-diff.ts"], "rules": { "max-lines": ["error", { "max": 913 }] } },
    { "files": ["packages/core/src/compile/compile.ts"], "rules": { "max-lines": ["error", { "max": 1087 }] } },
    { "files": ["packages/core/src/formatter/formatter.ts"], "rules": { "max-lines": ["error", { "max": 1045 }] } },
    { "files": ["packages/core/src/fs/import-resolver.ts"], "rules": { "max-lines": ["error", { "max": 1397 }] } },
    { "files": ["packages/core/src/parser/parser.ts"], "rules": { "max-lines": ["error", { "max": 1557 }] } },
    { "files": ["packages/core/src/parser/reference-validation.ts"], "rules": { "max-lines": ["error", { "max": 1082 }] } },
    { "files": ["packages/core/src/parser/style-parser.ts"], "rules": { "max-lines": ["error", { "max": 732 }] } },
    { "files": ["packages/core/src/renderer/crossing-marks.ts"], "rules": { "max-lines": ["error", { "max": 717 }] } },
    { "files": ["packages/core/src/renderer/deploy-layout.ts"], "rules": { "max-lines": ["error", { "max": 683 }] } },
    { "files": ["packages/core/src/renderer/drill-down-svg.ts"], "rules": { "max-lines": ["error", { "max": 918 }] } },
    { "files": ["packages/core/src/renderer/edge-routing-groups.ts"], "rules": { "max-lines": ["error", { "max": 2437 }] } },
    { "files": ["packages/core/src/renderer/group-layout.ts"], "rules": { "max-lines": ["error", { "max": 611 }] } },
    { "files": ["packages/core/src/renderer/label-placement.ts"], "rules": { "max-lines": ["error", { "max": 1012 }] } },
    { "files": ["packages/core/src/renderer/layout-types.ts"], "rules": { "max-lines": ["error", { "max": 604 }] } },
    { "files": ["packages/core/src/renderer/org-renderer.ts"], "rules": { "max-lines": ["error", { "max": 768 }] } },
    { "files": ["packages/core/src/renderer/org-tree-renderer.ts"], "rules": { "max-lines": ["error", { "max": 676 }] } },
    { "files": ["packages/core/src/resolver/style-resolver.ts"], "rules": { "max-lines": ["error", { "max": 886 }] } },
    { "files": ["packages/core/src/resolver/warnings.ts"], "rules": { "max-lines": ["error", { "max": 1703 }] } },
    { "files": ["packages/core/src/translate/db.ts"], "rules": { "max-lines": ["error", { "max": 718 }] } },
    { "files": ["packages/core/src/types/ast.ts"], "rules": { "max-lines": ["error", { "max": 1245 }] } },
    { "files": ["packages/i18n/src/en.ts"], "rules": { "max-lines": ["error", { "max": 631 }] } },
    { "files": ["packages/i18n/src/ja.ts"], "rules": { "max-lines": ["error", { "max": 630 }] } },
    { "files": ["packages/i18n/src/types.ts"], "rules": { "max-lines": ["error", { "max": 722 }] } }
  ],
  "settings": {
    "react": {
      "version": "19"
    }
  },
  "ignorePatterns": ["dist", "dist-viewer", "dist-serve", "dist-vscode-webview", "viewer-assets", "out", "node_modules", "*.d.ts"]
}
