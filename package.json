{
  "name": "karasu",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "dev": "pnpm --filter @karasu-tools/app run dev",
    "build": "pnpm --filter @karasu-tools/core run build && pnpm --filter @karasu-tools/i18n run build && pnpm --filter @karasu-tools/lsp run build && pnpm --filter @karasu-tools/app run build && pnpm --filter ./packages/cli run build",
    "test": "pnpm --filter @karasu-tools/core run test && pnpm --filter @karasu-tools/i18n run test && pnpm --filter @karasu-tools/app run test && pnpm --filter ./packages/cli run test && pnpm --filter @karasu-tools/lsp run test && pnpm --filter @karasu-tools/nest run test && pnpm --filter karasu-vscode run test && pnpm --filter @karasu-tools/docs-site run test && pnpm run test:scripts",
    "test:scripts": "vitest run --config scripts/vitest.config.ts",
    "test:coverage": "pnpm --filter @karasu-tools/core run test:coverage && pnpm --filter @karasu-tools/i18n run test:coverage && pnpm --filter @karasu-tools/app run test:coverage && pnpm --filter ./packages/cli run test:coverage && pnpm --filter @karasu-tools/nest run test:coverage && pnpm --filter @karasu-tools/docs-site run test:coverage && pnpm run test:scripts",
    "lint": "oxlint --deny-warnings packages/ scripts/",
    "lint:fix": "oxlint --fix packages/ scripts/",
    "format": "oxfmt --write packages/ scripts/",
    "format:check": "oxfmt --check packages/ scripts/",
    "typecheck": "pnpm -r run typecheck && tsc --noEmit -p scripts/tsconfig.json",
    "knip": "knip",
    "changeset": "changeset",
    "version-packages": "changeset version && pnpm install --lockfile-only",
    "release": "pnpm build && changeset publish",
    "check:cycles": "madge --circular --extensions ts,tsx packages/core/src packages/i18n/src packages/app/src packages/cli/src packages/lsp/src packages/nest/src packages/vscode/src",
    "check:licenses": "tsx scripts/ci/check-license-allowlist.ts",
    "gen:notices": "tsx scripts/ci/generate-third-party-notices.ts packages/cli packages/vscode",
    "adr:init": "adr init",
    "adr:validate": "adr validate",
    "adr:extract": "adr extract",
    "adr:visualize": "adr visualize",
    "adr:regenerate": "adr regenerate",
    "adr:check-assumptions": "adr check-assumptions",
    "adr:check-permalinks": "adr check-permalinks",
    "lint:e2e-page-goto": "tsx scripts/lint/no-direct-page-goto.ts",
    "lint:concept-adr-refs": "tsx scripts/lint/concept-adr-refs.ts",
    "lint:spec-structure-sync": "tsx scripts/lint/spec-structure-sync.ts",
    "lint:app-shortcut-docs-sync": "tsx scripts/lint/app-shortcut-docs-sync.ts",
    "lint:skill-cli-refs": "tsx scripts/lint/skill-cli-refs.ts",
    "lint:skill-reference-bundle-sync": "tsx scripts/lint/skill-reference-bundle-sync.ts",
    "lint:config-topics-sync": "tsx scripts/lint/config-topics-sync.ts",
    "lint:vitest-projects-sync": "tsx scripts/lint/vitest-projects-sync.ts",
    "lint:krs-fences": "tsx scripts/lint/krs-fences.ts",
    "lint:devcontainer-variants-sync": "tsx scripts/lint/devcontainer-variants-sync.ts",
    "lint:docs-site-ci-paths-sync": "tsx scripts/lint/docs-site-ci-paths-sync.ts",
    "lint:roadmap-issue-state": "tsx scripts/lint/roadmap-issue-state.ts",
    "lint:locale-normalization": "tsx scripts/lint/locale-normalization-single-owner.ts",
    "program:slices": "tsx scripts/program-slices.ts",
    "census:vocabulary": "tsx scripts/census/vocabulary.ts",
    "tpl:validate": "tpl validate --config tpl.config.json --packages-root packages",
    "tpl:related": "tpl related --config tpl.config.json",
    "tpl:review:body": "tpl review-body --repo kompiro/karasu",
    "at:check-coverage": "tsx scripts/acceptance/check-coverage.ts",
    "at:test": "vitest run --config scripts/vitest.config.ts scripts/acceptance",
    "qa:checklist": "tsx scripts/acceptance/generate-qa-checklist.ts",
    "gen:reference": "tsx scripts/reference/gen-docs.ts",
    "gen:guide-diagrams": "tsx scripts/guide/gen-guide-diagrams.ts",
    "report:demo": "tsx scripts/report/demo.ts"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@karasu-tools/core": "workspace:*",
    "@kompiro/adr-tools": "^0.0.12",
    "@kompiro/tpl-tools": "^0.0.7",
    "@playwright/test": "^1.49.0",
    "@types/node": "^26.2.0",
    "knip": "^6.32.0",
    "lefthook": "^2.1.10",
    "madge": "^8.0.0",
    "oxfmt": "^0.62.0",
    "oxlint": "1.76.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@resvg/resvg-wasm": "^2.6.2"
  }
}
