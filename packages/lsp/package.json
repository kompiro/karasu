{
  "name": "@karasu-tools/lsp",
  "version": "0.1.0",
  "private": true,
  "description": "Language Server for .krs architecture files",
  "license": "Apache-2.0",
  "main": "./out/server.js",
  "exports": {
    ".": "./out/server.js",
    "./protocol": "./src/protocol.ts"
  },
  "scripts": {
    "build": "esbuild src/server.ts --bundle --platform=node --format=cjs --outfile=out/server.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@karasu-tools/core": "workspace:*",
    "@karasu-tools/i18n": "workspace:*",
    "vscode-languageserver": "^11.0.0",
    "vscode-languageserver-protocol": "^3.18.5",
    "vscode-languageserver-textdocument": "^1.0.16"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
