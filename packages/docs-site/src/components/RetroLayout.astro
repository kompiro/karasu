---
// Shared shell for the hand-authored retrospective pages
// (src/pages/retrospective/index.astro and .../v1.0/index.astro). These pages
// are plain self-contained HTML documents outside the Starlight layout (a
// deliberate choice — see the pages themselves), so this component owns only
// what they duplicated: the palette/reset/topbar/hero/foot CSS that is
// byte-identical (or near-identical, with page-specific overrides layered on
// top via the "style" slot) across both pages, the topbar markup, and the
// language-toggle bootstrap script.
//
// hrefs stay plain relative (not BASE_URL-derived) per the retrospective
// pages' own convention — see the topbar comment below.
interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <style is:global>
      :root {
        --bg: #0f1115;
        --bg-card: #181b22;
        --bg-card2: #1f232c;
        --ink: #e6e9ef;
        --ink-dim: #98a2b3;
        --line: #2a2f3a;
        --crow: #c9a227;
        --feat: #4f9cf9;
        --adr: #c9a227;
        --tpl: #ec5fa0;
        --refactor: #34d399;
      }
      * {
        box-sizing: border-box;
      }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--ink);
        font-family:
          -apple-system, BlinkMacSystemFont, "Segoe UI", "Hiragino Sans", "Noto Sans JP", sans-serif;
        line-height: 1.7;
        font-size: 15px;
      }
      a {
        color: var(--feat);
        text-decoration: none;
      }
      .topbar {
        position: sticky;
        top: 0;
        z-index: 50;
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 10px 18px;
        background: rgba(15, 17, 21, 0.86);
        backdrop-filter: blur(8px);
        border-bottom: 1px solid var(--line);
      }
      .topbar .back {
        color: var(--ink-dim);
        font-size: 13px;
      }
      .topbar .back:hover {
        color: var(--ink);
      }
      .langtoggle {
        display: inline-flex;
        border: 1px solid var(--line);
        border-radius: 20px;
        overflow: hidden;
      }
      .langtoggle button {
        background: transparent;
        color: var(--ink-dim);
        border: 0;
        padding: 5px 14px;
        font-size: 12.5px;
        cursor: pointer;
        font-weight: 600;
      }
      .langtoggle button.active {
        background: var(--crow);
        color: #1a1a1a;
      }
      header.hero {
        text-align: center;
        background: radial-gradient(900px 400px at 50% -10%, rgba(201, 162, 39, 0.16), transparent 70%);
        border-bottom: 1px solid var(--line);
      }
      .crow-mark {
        line-height: 1;
        filter: drop-shadow(0 4px 12px rgba(201, 162, 39, 0.4));
      }
      header.hero h1 {
        margin: 14px 0 6px;
        letter-spacing: -0.02em;
      }
      header.hero h1 .jp {
        color: var(--crow);
        font-weight: 700;
      }
      .foot {
        padding-top: 22px;
        border-top: 1px solid var(--line);
        color: var(--ink-dim);
        font-size: 12.5px;
        text-align: center;
      }
    </style>
    <slot name="style" />
  </head>
  <body>
    <div class="topbar">
      <!-- Relative to this page's own fixed route, so base-agnostic. -->
      <a class="back" href="../" data-i="backHome">← karasu docs</a>
      <span class="langtoggle">
        <button data-lang="en" onclick="setLang('en')">English</button>
        <button data-lang="ja" onclick="setLang('ja')">日本語</button>
      </span>
    </div>
    <slot />
    <script is:inline>
      /* Shared language-toggle scaffolding for the retrospective pages.
         `setLang` is assigned onto `window` (not returned from an IIFE) so the
         topbar buttons' inline `onclick="setLang(...)"` handlers keep working. */
      function initLangToggle(I18N, renderPage) {
        window.setLang = function (lang) {
          const L = I18N[lang] || I18N.en;
          document.documentElement.lang = L.htmlLang;
          try {
            localStorage.setItem("karasu-retro-lang", lang);
          } catch (e) {}
          document
            .querySelectorAll(".langtoggle button")
            .forEach((b) => b.classList.toggle("active", b.dataset.lang === lang));
          document.querySelectorAll("[data-i]").forEach((node) => {
            const key = node.getAttribute("data-i");
            if (typeof L[key] === "string") node.innerHTML = L[key];
          });
          renderPage(lang, L);
        };

        const params = new URLSearchParams(location.search);
        let lang = params.get("lang");
        if (lang !== "en" && lang !== "ja") {
          try {
            lang = localStorage.getItem("karasu-retro-lang");
          } catch (e) {}
        }
        if (lang !== "en" && lang !== "ja") lang = "en";
        setLang(lang);
      }
    </script>
    <slot name="script" />
  </body>
</html>
