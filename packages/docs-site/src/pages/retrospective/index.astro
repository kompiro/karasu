---
import RetroLayout from "../../components/RetroLayout.astro";
---

<RetroLayout
  title="karasu — Development Retrospectives"
  description="An index of karasu development retrospectives — periodic looks back at how the project grew, tracking commits, ADRs, and TPLs."
>
  <style is:global slot="style">
      header.hero {
        padding: 72px 24px 44px;
      }
      .crow-mark {
        font-size: 52px;
      }
      header.hero h1 {
        font-size: 34px;
      }
      header.hero .sub {
        color: var(--ink-dim);
        font-size: 16px;
        margin: 0 auto;
        max-width: 640px;
      }
      .wrap {
        max-width: 860px;
        margin: 0 auto;
        padding: 40px 24px 96px;
      }
      .edition {
        display: block;
        background: var(--bg-card);
        border: 1px solid var(--line);
        border-radius: 16px;
        padding: 26px 28px;
        margin: 18px 0;
        position: relative;
        overflow: hidden;
        transition:
          border-color 0.15s,
          transform 0.15s;
      }
      .edition::before {
        content: "";
        position: absolute;
        left: 0;
        top: 0;
        bottom: 0;
        width: 5px;
        background: var(--accent, var(--crow));
      }
      .edition:hover {
        border-color: var(--crow);
        transform: translateY(-2px);
      }
      .edition .etag {
        display: inline-block;
        font-size: 11.5px;
        font-weight: 700;
        color: #1a1a1a;
        background: var(--crow);
        border-radius: 20px;
        padding: 2px 12px;
        margin-bottom: 10px;
      }
      .edition h2 {
        margin: 0 0 4px;
        font-size: 22px;
        color: var(--ink);
      }
      .edition .period {
        color: var(--ink-dim);
        font-size: 13px;
        font-variant-numeric: tabular-nums;
        margin: 0 0 12px;
      }
      .edition .blurb {
        color: var(--ink);
        font-size: 14px;
        margin: 0 0 16px;
      }
      .edition .stats {
        display: flex;
        gap: 22px;
        flex-wrap: wrap;
        font-variant-numeric: tabular-nums;
        font-size: 13px;
        color: var(--ink-dim);
      }
      .edition .stats b {
        font-size: 17px;
      }
      .edition .more {
        margin-top: 16px;
        color: var(--crow);
        font-weight: 600;
        font-size: 13.5px;
      }
      .upcoming {
        text-align: center;
        color: var(--ink-dim);
        font-size: 13px;
        border: 1px dashed var(--line);
        border-radius: 14px;
        padding: 20px;
        margin-top: 26px;
      }
      .foot {
        margin-top: 56px;
      }
  </style>

  <header class="hero">
    <div class="crow-mark">🐦‍⬛</div>
    <h1><span class="jp">karasu</span> <span data-i="title"></span></h1>
    <p class="sub" data-i="sub"></p>
  </header>

  <div class="wrap">
    <div id="editions"></div>
    <div class="upcoming" data-i="upcoming"></div>
    <div class="foot" data-i="foot"></div>
  </div>

  <script is:inline slot="script">
    /* Each retrospective edition. Add a new entry here as future editions ship;
       the page renders them newest-first as cards. hrefs are relative to this
       page's fixed route /retrospective/, so they are base-agnostic. */
    const EDITIONS = [
      {
        href: "v1.0/",
        accent: "#34d399",
        tag: "v1.0",
        en: {
          title: "1.0 — The road to the language spec",
          period: "2026-03-13 → 2026-06-25 · ~15 weeks",
          blurb:
            "From the core idea of separating logical and physical structure to a frozen .krs / .krs.style v1.0 (stable) spec — monthly and weekly summaries with the growth of ADRs and TPLs.",
        },
        ja: {
          title: "1.0 — 言語仕様への道",
          period: "2026-03-13 → 2026-06-25 · 約15週間",
          blurb:
            "論理／物理分離という核心思想から、凍結された .krs / .krs.style v1.0 (stable) 仕様まで — 月次・週次サマリと ADR・TPL の成長を追う。",
        },
        stats: [
          { num: "1,127", en: "commits", ja: "コミット", color: "var(--feat)" },
          { num: "237", en: "ADRs", ja: "ADR", color: "var(--adr)" },
          { num: "64", en: "TPLs", ja: "TPL", color: "var(--tpl)" },
        ],
      },
    ];

    const I18N = {
      en: {
        htmlLang: "en",
        title: "Development Retrospectives",
        backHome: "← karasu docs",
        sub: "Periodic looks back at how karasu grew — commits, design decisions (ADRs), and test perspectives (TPLs) over time.",
        more: "Read the retrospective →",
        upcoming: "More editions will be added here as the project reaches new milestones.",
        foot: "Auto-extracted from the karasu repository's git history, docs/adr/, and docs/test-perspectives/.",
      },
      ja: {
        htmlLang: "ja",
        title: "開発ふりかえり",
        backHome: "← karasu ドキュメント",
        sub: "karasu がどう育ったかを定期的にふりかえる場 — コミット・設計判断（ADR）・テスト観点（TPL）の歩み。",
        more: "ふりかえりを読む →",
        upcoming: "今後マイルストーンを迎えるたびに、ここへエディションを追加していきます。",
        foot: "karasu リポジトリの git 履歴・docs/adr/・docs/test-perspectives/ から自動抽出。",
      },
    };

    function renderEditions(lang, L) {
      document.getElementById("editions").innerHTML = EDITIONS.map((e) => {
        const c = e[lang];
        const stats = e.stats
          .map(
            (s) =>
              `<div><b style="color:${s.color}">${s.num}</b> ${s[lang]}</div>`,
          )
          .join("");
        return `<a class="edition" style="--accent:${e.accent}" href="${e.href}?lang=${lang}">
          <span class="etag">${e.tag}</span>
          <h2>${c.title}</h2>
          <p class="period">${c.period}</p>
          <p class="blurb">${c.blurb}</p>
          <div class="stats">${stats}</div>
          <div class="more">${L.more}</div>
        </a>`;
      }).join("");
    }

    initLangToggle(I18N, renderEditions);
  </script>
</RetroLayout>
