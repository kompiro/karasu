{
  // The build scripts, typechecked apart from `../tsconfig.json`, whose
  // `rootDir: ./src` would reject files outside `src/`.
  "extends": "../../../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["node"]
  },
  "include": ["*.ts"]
}
