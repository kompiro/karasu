{
  // The Pages Functions, typechecked by the root `typecheck` script. Nothing
  // else covers them: they are no workspace package. Pages ignores this file
  // (it builds routes from `.ts` / `.js` modules only).
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "lib": ["ES2022", "DOM"],
    "types": []
  },
  "include": ["**/*.ts"]
}
