{
  // ローカル開発用。クラウド（Codespaces / Devin 等）用は `.devcontainer/cloud/devcontainer.json`
  // にあり、Codespace 作成時のドロップダウンで選べる。差分は `mounts` の有無だけで、
  // それ以外が一致していることは `pnpm lint:devcontainer-variants-sync` が検証する。
  //
  // 下の `mounts` はホストの設定をコンテナへ共有するためのもの（意図的）。
  // クラウドにはその「ホスト」が無いので、あちらは持たない。
  "name": "karasu",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/git:1.3.8": {},
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "mounts": [
    "source=${localEnv:HOME}/.claude,target=/home/node/.claude,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.config/git/,target=/home/node/.config/git/,type=bind,consistency=cached",
    "source=gh-config,target=/home/node/.config/gh,type=volume"
  ],
  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "/home/node/.claude"
  },
  "remoteUser": "node",
  "forwardPorts": [5173],
  "portsAttributes": {
    "5173": {
      "label": "Vite Dev Server",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "oxc.oxc-vscode",
        "vitest.explorer",
        "ms-vscode.vscode-typescript-next",
        "ms-azuretools.vscode-containers",
        "peakchen90.open-html-in-browser",
        "Anthropic.claude-code"
      ],
      "settings": {
        "js/ts.tsdk.path": "node_modules/typescript/lib",
        "editor.formatOnSave": true,
        "[typescript]": {
          "editor.defaultFormatter": "oxc.oxc-vscode"
        },
        "[typescriptreact]": {
          "editor.defaultFormatter": "oxc.oxc-vscode"
        },
        "[javascript]": {
          "editor.defaultFormatter": "oxc.oxc-vscode"
        },
        "[json]": {
          "editor.defaultFormatter": "oxc.oxc-vscode"
        }
      }
    }
  }
}
