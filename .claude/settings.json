{
  "permissions": {
    "allow": [
      "Bash(git:*)",
      "Bash(gh:*)",
      "Bash(cd /workspaces/karasu* && git:*)"
    ],
    "additionalDirectories": [
      "/workspaces",
      "/workspaces/karasu",
      "/workspaces/karasu/.claude",
      "/workspaces/karasu/.worktrees"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "FILE=$(jq -r '.tool_input.file_path'); case \"$FILE\" in *.ts|*.tsx) cd /workspaces/karasu && npx oxfmt --write \"$FILE\" 2>&1 && npx oxlint \"$FILE\" 2>&1 ;; esac"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/coderabbit/converge-after-ready.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/coderabbit/converge-after-ready.sh",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "commit-commands@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "engineering@anthropic-plugin-directory": true,
    "hane@kompiro-hane": true,
    "coderabbit@claude-plugins-official": true
  },
  "defaultMode": "acceptEdits"
}
